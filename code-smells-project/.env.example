# Chave de assinatura do Flask. Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Nunca habilite em produção (ativa o debugger interativo do Werkzeug)
DEBUG=false
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

DATABASE_PATH=loja.db

# Token exigido no header X-Admin-Token para POST /admin/reset-db (vazio = endpoint desabilitado)
ADMIN_TOKEN=

# Senhas dos usuários de exemplo criados no primeiro boot
SEED_ADMIN_PASSWORD=
SEED_CLIENTE_PASSWORD=
