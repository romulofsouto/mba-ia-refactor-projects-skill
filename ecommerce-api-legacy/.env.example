# HTTP port
PORT=3000
# SQLite file path (":memory:" keeps the original in-memory behaviour)
DB_PATH=:memory:
# Payment gateway key (never commit the real value)
PAYMENT_GATEWAY_KEY=
# Token required in the X-Admin-Token header for /api/admin/* and DELETE /api/users/:id
ADMIN_TOKEN=
# debug | info | warn | error
LOG_LEVEL=info
