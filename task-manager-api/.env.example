# Chave de assinatura do Flask e dos tokens de login.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Nunca habilite em produção (ativa o debugger interativo do Werkzeug)
DEBUG=false
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

DATABASE_URL=sqlite:///tasks.db

# Validade (segundos) do token devolvido por POST /login
AUTH_TOKEN_MAX_AGE=86400

# Credenciais SMTP usadas pelo NotificationService
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
